#!/usr/bin/env bash
set -euo pipefail

package_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$package_root"

if [[ -f ../../bootstrap.php && -d ../../vendor ]]; then
    if ! command -v ddev >/dev/null 2>&1; then
        echo 'DDEV is required for the workspace pre-commit check.' >&2
        exit 1
    fi
    ddev exec 'cd plugins/formie-sms && composer ci'
else
    composer check-platform-reqs
    composer ci
fi
